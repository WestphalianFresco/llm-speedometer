{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LLM Speedometer",
  "version": "0.5.0",
  "identifier": "dev.williamfan.llmspeedometer",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LLM Speedometer",
        "width": 470,
        "height": 432,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "../build/com.williamfan.llmmeter.streamDeckPlugin"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MjA1OEI4MzI1MTI1NEQKUldSTkpWRXl1RmdnNmJiY04waHlBczcyWUo3aURpQ2ZMS0ViR04vTUVzTVBmUVBZcmlCT2dUWnYK",
      "endpoints": [
        "https://github.com/WestphalianFresco/llm-speedometer/releases/latest/download/latest.json"
      ]
    }
  }
}
